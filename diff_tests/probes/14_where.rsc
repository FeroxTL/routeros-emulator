# where / property-value comparisons: coercions and operators (verified on 7.9)
:put (1 = "1")
:put (true = "yes")
:put ("abc" ~ "b")
:put ("x" != "y")
:put ("192.168.0.0" in "192.168.0.0/16")
:put (192.168.8.1 in "192.168.0.0/16")
:put (5 > 3)
:put (true and (2 = 2))
:put ("10.4.0.0" in "10.4.0.0/14")
:put (true || false)
:put (true && true)
:put (false && true)
