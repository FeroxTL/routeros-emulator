# Arithmetic and number/operator tokenization
# Format: each line `:put (expr)` prints the result. One line = one probe.
:put (10+4)
:put (10 + 4)
:put (10 +4)
:put (10+ 4)
:put (10 - 4)
:put (10 -4)
:put (10- 4)
:put (10-4)
:put (2*3)
:put (2 * 3)
:put (6/3)
:put (6 / 3)
:put (6 /3)
:put (6/ 3)
:put (10/4)
:put (10 / 4)
:put (7 / 2)
:put (5 % 2)
:put (5%2)
:put (2.5)
:put (2.5 + 1)
:put (1.5)
:put (3 / 2)
:put (100 / 40)
:put (-5)
:put (-2 + 3)
:put (3 - -2)
:put (2 ^ 3)
:put (2 * 3 + 4)
:put (2 + 3 * 4)
:put ((2 + 3) * 4)
:put (10 / 4 / 2)
:put (1 / 3)
:put (0.1 + 0.2)
:put (5 >> 1)
:put (5 << 1)
:put (5 & 3)
:put (5 | 1)
:put (5 && 0)
:put (1 || 0)